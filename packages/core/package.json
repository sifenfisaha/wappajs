{
  "name": "@wappajs/core",
  "version": "0.2.0",
  "description": "Transport-agnostic core for building WhatsApp agents: agent loop, tools, middleware, sessions.",
  "type": "module",
  "license": "MIT",
  "author": "Sifen Fisaha",
  "homepage": "https://github.com/sifenfisaha/wappajs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sifenfisaha/wappajs.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/sifenfisaha/wappajs/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "keywords": [
    "whatsapp",
    "agent",
    "bot",
    "llm",
    "framework"
